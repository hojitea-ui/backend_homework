# 세션 쿠키 서명 키. 이 값이 바뀌면 모든 사용자의 쿠키가 무효가 되고,
# 기기 바인딩 방식이라 기록에 다시 접근할 수 없게 된다. 절대 커밋하지 말 것.
# 새로 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=여기에_32자_이상의_임의값_넣기

# 서버 설정
PORT=3000

# DB 파일 경로 (프로젝트 루트 기준)
DB_PATH=./data/haru.db

# 날씨 기본 위치 (사용자가 설정에서 바꿀 수 있음)
DEFAULT_LOCATION_NAME=서울
DEFAULT_LATITUDE=37.5665
DEFAULT_LONGITUDE=126.9780

# 출석을 받기 시작하는 시점 (목표 시간보다 이만큼 전부터)
# 밤을 새운 사람이 새벽에 눌러 성공을 챙기는 걸 막는 하한선
EARLY_CHECKIN_WINDOW_MINUTES=180

# 날씨 캐시 유지 시간(분)
WEATHER_CACHE_MINUTES=30

# Open-Meteo는 API 키가 필요 없어 지금은 비밀값이 없음.
# 키가 필요한 API(예: OpenWeatherMap)로 바꾸면 여기에 넣고 .env는 커밋하지 말 것.
# WEATHER_API_KEY=
