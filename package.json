{
  "name": "backend-homework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "오늘도 하루를 시작해볼까요? — 기상 후 출석체크 앱",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/initdb.js && node src/server.js",
